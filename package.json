{
  "name": "sable-next",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "predev": "pnpm wasm:dev",
    "dev": "vite dev",
    "prebuild": "pnpm wasm:build",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "svelte-kit sync || echo ''; mise exec -- lefthook install",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "check": "svelte-kit sync && node scripts/check-theme-tokens.mjs && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.service-worker.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch",
    "lint": "eslint . --cache --cache-strategy content --max-warnings 0",
    "lint:fix": "eslint . --cache --cache-strategy content --fix",
    "stylelint": "stylelint \"src/**/*.{css,svelte}\" --max-warnings 0",
    "stylelint:fix": "stylelint \"src/**/*.{css,svelte}\" --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "wasm:build": "mise exec -- node scripts/build-wasm.mjs --release",
    "wasm:dev": "mise exec -- node scripts/build-wasm.mjs",
    "wasm:watch": "mise exec -- watchexec --restart --watch crates/sable-core --watch crates/sable-wasm -- pnpm wasm:dev",
    "tauri": "tauri"
  },
  "dependencies": {
    "@arborium/arborium": "^2.18.1",
    "@fontsource-variable/nunito": "5.3.0",
    "@tanstack/svelte-query": "^6.1.38",
    "@tanstack/svelte-virtual": "^3.13.35",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-os": "2.3.2",
    "bits-ui": "^2.18.1",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "0.18.4",
    "phosphor-svelte": "^3.1.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2",
    "svelte-i18next": "^2.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sentry/sveltekit": "^10.70.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/katex": "^0.16.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.63.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-plugin-defensive-css": "^2.9.6",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "testcontainers": "^12.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.14.0"
    }
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
