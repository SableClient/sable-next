{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommitTypeAll(chore)',
    ':gitSignOff',
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'Europe/Paris',
  schedule: ['* 0-3 * * 1'],
  labels: ['dependencies'],
  minimumReleaseAge: '7 days',
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
    },
    {
      matchManagers: ['npm'],
      groupName: 'npm',
    },
    {
      matchManagers: ['cargo', 'rust-toolchain'],
      groupName: 'cargo',
    },
    {
      description: 'Tauri and its plugins move together',
      matchPackageNames: ['/^tauri(?:-.*)?$/'],
      groupName: 'tauri',
    },
    {
      matchManagers: ['terraform'],
      groupName: 'terraform',
    },
    {
      matchManagers: ['mise'],
      groupName: 'mise',
    },
    {
      matchManagers: ['dockerfile'],
      groupName: 'docker',
    },
    {
      matchDatasources: ['git-refs'],
      matchPackageNames: [
        'https://github.com/matrix-org/matrix-rust-sdk{,.git}',
        'https://github.com/ruma/ruma{,.git}',
      ],
      groupName: 'matrix-rust-sdk',
    },
    {
      matchDatasources: ['git-refs'],
      matchPackageNames: ['https://github.com/SableClient/**'],
      enabled: false,
    },
    {
      matchManagers: ['gradle', 'gradle-wrapper'],
      enabled: false,
    },
  ],
}
