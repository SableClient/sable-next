{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommitTypeAll(chore)',
    ':gitSignOff',
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'Europe/Paris',
  schedule: ['* 0-3 * * 1'],
  labels: ['dependencies'],
  minimumReleaseAge: '7 days',
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  lockFileMaintenance: {
    enabled: true,
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/\\.nix$/'],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*\\S+\\s*=\\s*"(?<currentValue>[^"]+)";',
      ],
    },
  ],
  packageRules: [
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
    },
    {
      matchManagers: ['npm'],
      groupName: 'npm',
    },
    {
      matchManagers: ['cargo', 'rust-toolchain'],
      groupName: 'cargo',
    },
    {
      description: 'wasm-bindgen-cli must match the wasm-bindgen version in Cargo.lock',
      matchPackageNames: ['wasm-bindgen-cli'],
      groupName: 'cargo',
    },
    {
      description: 'Tauri and its plugins move together',
      matchPackageNames: ['/^tauri(?:-.*)?$/', '/^@tauri-apps\\//'],
      groupName: 'tauri',
    },
    {
      matchManagers: ['terraform'],
      groupName: 'terraform',
    },
    {
      matchManagers: ['mise'],
      groupName: 'mise',
    },
    {
      matchManagers: ['dockerfile'],
      groupName: 'docker',
    },
    {
      matchDatasources: ['git-refs'],
      matchPackageNames: [
        'https://github.com/matrix-org/matrix-rust-sdk{,.git}',
        'https://github.com/ruma/ruma{,.git}',
      ],
      groupName: 'matrix-rust-sdk',
    },
    {
      description: 'Git revisions are updated manually',
      matchDatasources: ['git-refs'],
      matchPackageNames: [
        'https://github.com/SableClient/**',
        'https://git.sable.moe/SableClient/matrix-rust-sdk{,.git}',
        'https://github.com/ruma/ruma{,.git}',
        'https://github.com/yanqianglu/tauri-plugin-auth-session{,.git}',
      ],
      enabled: false,
    },
    {
      matchManagers: ['gradle', 'gradle-wrapper'],
      enabled: false,
    },
    {
      description: 'SvelteKit and typescript-eslint still require the TypeScript 6 API',
      matchManagers: ['npm'],
      matchPackageNames: ['typescript'],
      allowedVersions: '<7',
    },
    {
      description: 'Match ruma-html until the Ruma pin is updated',
      matchManagers: ['cargo'],
      matchPackageNames: ['html5ever'],
      allowedVersions: '<0.40',
    },
    {
      description: 'Share libsqlite3-sys with the pinned Matrix SDK',
      matchManagers: ['cargo'],
      matchPackageNames: ['rusqlite'],
      allowedVersions: '<0.41',
    },
    {
      description: 'Keep PipeWire compatible with the Audiofox bindings',
      matchManagers: ['cargo'],
      matchPackageNames: ['pipewire'],
      allowedVersions: '<0.11',
    },
    {
      description: 'Keep compatibility pins until backtrace on iOS and deep-link on Linux support newer dependencies',
      matchManagers: ['cargo'],
      matchPackageNames: ['libc', 'rust-ini'],
      enabled: false,
    },
  ],
}
