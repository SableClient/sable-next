{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sable /.well-known/sable",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appName": {
          "type": "string"
        },
        "logoUrl": {
          "type": "string",
          "pattern": "^(https://|[^:]*$)"
        },
        "faviconUrl": {
          "type": "string",
          "pattern": "^(https://|[^:]*$)"
        },
        "themeUrl": {
          "type": "string",
          "pattern": "^(https://|[^:]*$)"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "help": {
          "type": "string",
          "pattern": "^https?://"
        },
        "privacy": {
          "type": "string",
          "pattern": "^https?://"
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              }
            },
            "required": [
              "text",
              "url"
            ]
          }
        },
        "supportRoom": {
          "type": "string"
        },
        "bugReport": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "hideCommunityLinks": {
      "type": "boolean",
      "default": false
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ssoRedirect": {
          "enum": [
            "immediate",
            "loginPage",
            null
          ]
        },
        "disableRegistration": {
          "type": "boolean",
          "default": false
        },
        "logoutRedirectUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "deviceDisplayName": {
          "type": "string"
        }
      }
    },
    "hideUsernamePasswordFields": {
      "type": "boolean",
      "default": false
    },
    "settingsDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "title": "Language",
          "enum": [
            "system",
            "ar",
            "bg",
            "cs",
            "de",
            "en",
            "es",
            "fi",
            "fr",
            "hu",
            "it",
            "mi",
            "nl",
            "pl",
            "pt",
            "pt-BR",
            "ro",
            "ru",
            "th",
            "tok",
            "tr",
            "uk",
            "zh-Hans"
          ],
          "default": "system"
        },
        "layout": {
          "title": "Layout",
          "enum": [
            "modern",
            "compact",
            "bubble"
          ],
          "default": "modern"
        },
        "threadPresentation": {
          "title": "Threads and discussions",
          "enum": [
            "timeline",
            "panel"
          ],
          "default": "timeline"
        },
        "alignOwnMessages": {
          "title": "Right-align own messages",
          "type": "boolean",
          "default": true
        },
        "avatarsInMessageHeaders": {
          "title": "Display avatars in message headers",
          "type": "boolean",
          "default": true
        },
        "messageSpacing": {
          "title": "Message spacing",
          "enum": [
            "none",
            "compact",
            "cozy",
            "roomy"
          ],
          "default": "cozy"
        },
        "timelineEmoteSize": {
          "title": "Emote size",
          "enum": [
            "default",
            "20",
            "24",
            "32",
            "48",
            "64"
          ],
          "default": "default"
        },
        "theme": {
          "title": "Light or dark",
          "enum": [
            "system",
            "dark",
            "light"
          ],
          "default": "system"
        },
        "fontFamily": {
          "type": "string",
          "default": ""
        },
        "fontFamilyMono": {
          "type": "string",
          "default": ""
        },
        "codeLigatures": {
          "type": "boolean",
          "default": true
        },
        "underlineLinks": {
          "title": "Always underline links",
          "type": "boolean",
          "default": true
        },
        "renderRoomColors": {
          "title": "Use room colours instead of profile colours",
          "type": "boolean",
          "default": true
        },
        "renderProfileColors": {
          "title": "Show profile name colours",
          "type": "boolean",
          "default": true
        },
        "reducedMotion": {
          "title": "Reduce motion",
          "type": "boolean"
        },
        "pageZoom": {
          "title": "Interface scale",
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.5,
          "default": 1
        },
        "textScale": {
          "title": "Text size",
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.5,
          "default": 1
        },
        "highContrast": {
          "title": "Increase contrast",
          "type": "boolean",
          "default": false
        },
        "alwaysShowAltText": {
          "title": "Always show image descriptions",
          "type": "boolean",
          "default": false
        },
        "twitterEmoji": {
          "title": "Twitter emoji",
          "type": "boolean",
          "default": true
        },
        "pixelatedImages": {
          "title": "Pixelated image scaling",
          "enum": [
            "always",
            "smart",
            "never"
          ],
          "default": "never"
        },
        "nameColorCorrection": {
          "title": "Improve name colour readability",
          "enum": [
            "strong",
            "weak",
            "off"
          ],
          "default": "strong"
        },
        "showRoomIcon": {
          "title": "Room icons",
          "enum": [
            "always",
            "sometimes",
            "collapsed",
            "never"
          ],
          "default": "always"
        },
        "showRoomBanners": {
          "title": "Room banners above the list",
          "type": "boolean",
          "default": true
        },
        "showDmTopics": {
          "title": "Show topics in direct messages",
          "type": "boolean",
          "default": true
        },
        "roomBannerHeight": {
          "type": "number",
          "minimum": 56,
          "maximum": 500,
          "default": 190
        },
        "subspaceHierarchyLimit": {
          "title": "Subspace nesting depth",
          "enum": [
            "2",
            "3",
            "4",
            "5",
            "6",
            "7",
            "8",
            "9",
            "10"
          ],
          "default": "3"
        },
        "showHome": {
          "title": "All rooms in the sidebar",
          "type": "boolean",
          "default": false
        },
        "restoreLastRoom": {
          "title": "Restore last viewed room",
          "type": "boolean",
          "default": true
        },
        "showSearch": {
          "title": "Show search in the sidebar",
          "type": "boolean",
          "default": false
        },
        "showUnreadCounts": {
          "title": "Show counts on quiet rooms",
          "type": "boolean",
          "default": false
        },
        "badgeCountDMsOnly": {
          "title": "Show counts on quiet direct messages",
          "type": "boolean",
          "default": true
        },
        "showEasterEggs": {
          "title": "Show :3 instead of 1k+ on huge counts",
          "type": "boolean",
          "default": true
        },
        "showPingCounts": {
          "title": "Show counts on mentions",
          "type": "boolean",
          "default": true
        },
        "showUnreadDots": {
          "title": "Show dots on rooms with unread messages but no mention",
          "type": "boolean",
          "default": true
        },
        "uniformIcons": {
          "title": "Fill transparent room icons",
          "type": "boolean",
          "default": false
        },
        "tintRoomIcons": {
          "title": "Theme vector room icons",
          "type": "boolean",
          "default": false
        },
        "showBridgeBadges": {
          "title": "Show the bridged network on room icons",
          "type": "boolean",
          "default": true
        },
        "showSpaceEvents": {
          "title": "Show today’s events in spaces",
          "type": "boolean",
          "default": true
        },
        "hour24Clock": {
          "title": "24-hour clock",
          "type": "boolean",
          "default": false
        },
        "dateFormat": {
          "title": "Date format",
          "enum": [
            "auto",
            "dmy",
            "mdy",
            "ymd"
          ],
          "default": "auto"
        },
        "timeZone": {
          "title": "Time zone",
          "type": "string",
          "default": "auto"
        },
        "weekStart": {
          "title": "First day of the calendar week",
          "enum": [
            "sunday",
            "monday",
            "saturday"
          ],
          "default": "sunday"
        },
        "hideMembershipEvents": {
          "title": "Hide joins and leaves",
          "type": "boolean",
          "default": false
        },
        "hideProfileChanges": {
          "title": "Hide name and avatar changes",
          "type": "boolean",
          "default": true
        },
        "hideTopicChanges": {
          "title": "Hide topic changes",
          "type": "boolean",
          "default": false
        },
        "hideMemberInReadOnly": {
          "title": "Hide members in read-only rooms",
          "type": "boolean",
          "default": true
        },
        "showTombstoneEvents": {
          "title": "Show removed-message placeholders",
          "type": "boolean",
          "default": true
        },
        "openRoomsAtUnread": {
          "title": "Open rooms at the first unread message",
          "type": "boolean",
          "default": true
        },
        "jumpToLatestOnSend": {
          "title": "Jump to your message when you send",
          "type": "boolean",
          "default": false
        },
        "hideReadReceipts": {
          "title": "Hide read receipts",
          "type": "boolean",
          "default": false
        },
        "readReceiptPlacement": {
          "title": "Receipt position",
          "enum": [
            "message",
            "room"
          ],
          "default": "message"
        },
        "replyPreviewStyle": {
          "title": "Reply preview",
          "enum": [
            "connected",
            "compact",
            "expanded"
          ],
          "default": "connected"
        },
        "captionPosition": {
          "title": "Caption placement",
          "enum": [
            "above",
            "below",
            "inline",
            "hidden"
          ],
          "default": "below"
        },
        "usernameClick": {
          "title": "Name click action",
          "enum": [
            "mention",
            "profile"
          ],
          "default": "mention"
        },
        "doubleTapReact": {
          "title": "Double tap to react",
          "type": "boolean",
          "default": true
        },
        "messageSwipeAction": {
          "title": "Swipe left on a message to",
          "enum": [
            "reply",
            "members"
          ],
          "default": "reply"
        },
        "showSingleReactionCount": {
          "title": "Show the count on single reactions",
          "type": "boolean",
          "default": true
        },
        "showAllTimestamps": {
          "title": "Show the time on every message",
          "type": "boolean",
          "default": false
        },
        "showRoleTooltip": {
          "title": "Show role name on hover",
          "type": "boolean",
          "default": false
        },
        "hideMessageShields": {
          "title": "Hide minor security warnings",
          "type": "boolean",
          "default": false
        },
        "doubleTapReaction": {
          "type": "string",
          "default": "❤️"
        },
        "hideTypingIndicators": {
          "title": "Hide typing indicators",
          "type": "boolean",
          "default": false
        },
        "memberSort": {
          "enum": [
            "name-asc",
            "name-desc",
            "newest",
            "oldest"
          ],
          "default": "name-asc"
        },
        "roomSort": {
          "enum": [
            "recent",
            "name-asc",
            "name-desc"
          ],
          "default": "recent"
        },
        "directSort": {
          "enum": [
            "recent",
            "name-asc",
            "name-desc"
          ],
          "default": "recent"
        },
        "groupMembersByPresence": {
          "title": "Group members by presence",
          "type": "boolean",
          "default": true
        },
        "filterPronounsByLanguage": {
          "title": "Match pronouns to interface language",
          "type": "boolean",
          "default": true
        },
        "showPronouns": {
          "title": "Show pronouns",
          "type": "boolean",
          "default": true
        },
        "showPronounPills": {
          "title": "Show pronoun pills",
          "type": "boolean",
          "default": true
        },
        "pronounPillLimit": {
          "title": "Pronoun pills per message",
          "enum": [
            "1",
            "2",
            "3",
            "all"
          ],
          "default": "3"
        },
        "pronounPillLength": {
          "title": "Pronoun pill length",
          "enum": [
            "12",
            "16",
            "24",
            "all"
          ],
          "default": "all"
        },
        "composerForm": {
          "title": "Composer height",
          "enum": [
            "short",
            "adaptive",
            "tall"
          ],
          "default": "tall"
        },
        "alwaysInlineEditor": {
          "title": "Always inline editor",
          "type": "boolean",
          "default": false
        },
        "enterForNewline": {
          "title": "Newline on touch screens, send otherwise",
          "enum": [
            "adaptive",
            "newline",
            "send"
          ],
          "default": "adaptive"
        },
        "sedEdits": {
          "title": "Edit your last message with s/old/new",
          "type": "boolean",
          "default": false
        },
        "inlineEditing": {
          "title": "Edit messages in the timeline",
          "type": "boolean",
          "default": false
        },
        "mentionInReplies": {
          "title": "Default reply notifications",
          "type": "boolean",
          "default": true
        },
        "formattingToolbar": {
          "title": "Keep formatting toolbar open",
          "type": "boolean",
          "default": false
        },
        "composerFormatButton": {
          "title": "Formatting button",
          "type": "boolean",
          "default": true
        },
        "richTextComposer": {
          "title": "Format text as you type",
          "type": "boolean",
          "default": false
        },
        "composerSpellcheck": {
          "title": "Spell check",
          "type": "boolean",
          "default": true
        },
        "composerAutocapitalize": {
          "title": "Capitalize sentences",
          "type": "boolean",
          "default": true
        },
        "emoticonToEmoji": {
          "title": "Convert emoticons to emoji",
          "type": "boolean",
          "default": false
        },
        "composerGifButton": {
          "title": "GIF button",
          "type": "boolean",
          "default": true
        },
        "composerStickerButton": {
          "title": "Sticker button",
          "type": "boolean",
          "default": true
        },
        "composerEmoteButton": {
          "title": "Emote button",
          "type": "boolean",
          "default": true
        },
        "composerVoiceButton": {
          "title": "Voice message button",
          "type": "boolean",
          "default": true
        },
        "composerButtonOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "gif",
              "sticker",
              "emoticon",
              "persona",
              "format",
              "separator:0",
              "separator:1",
              "separator:2",
              "separator:3",
              "separator:4",
              "separator:5",
              "separator:6",
              "separator:7",
              "separator:8"
            ]
          },
          "default": [
            "gif",
            "sticker",
            "emoticon",
            "separator:0",
            "persona",
            "format"
          ]
        },
        "sendAttachmentAsCaption": {
          "title": "Use message text as attachment caption",
          "type": "boolean",
          "default": true
        },
        "sendAttachmentsAsGallery": {
          "title": "Combine attachments into a gallery",
          "type": "boolean",
          "default": false
        },
        "personaPicker": {
          "title": "Show profile picker in the composer",
          "type": "boolean",
          "default": true
        },
        "personaPickerSortOrder": {
          "title": "Profile picker sort order",
          "enum": [
            "manual",
            "alphabetical-asc",
            "alphabetical-desc",
            "recent"
          ],
          "default": "recent"
        },
        "personaPickerLeftSide": {
          "title": "Pin picker to left side of composer",
          "type": "boolean",
          "default": false
        },
        "personaPickerShowAccountWhenDeselected": {
          "title": "Preview account avatar when deselected",
          "type": "boolean",
          "default": true
        },
        "personaProxying": {
          "title": "Shorthand triggers",
          "type": "boolean",
          "default": false
        },
        "personaSelectionScope": {
          "title": "Remember the selected profile",
          "enum": [
            "account",
            "space",
            "room",
            "picker"
          ],
          "default": "picker"
        },
        "personaKeepAfterShorthand": {
          "title": "Keep the profile selected after shorthand",
          "type": "boolean",
          "default": false
        },
        "personaFallback": {
          "title": "Prefix messages with profile names for older clients",
          "type": "boolean",
          "default": true
        },
        "personaGrid": {
          "type": "boolean",
          "default": true
        },
        "personaAlternateAvatar": {
          "type": "boolean",
          "default": false
        },
        "sendTypingNotifications": {
          "title": "Send typing notifications",
          "type": "boolean",
          "default": true
        },
        "sendReadReceipts": {
          "title": "Read receipts",
          "type": "boolean",
          "default": true
        },
        "sendPresence": {
          "title": "Online status",
          "type": "boolean",
          "default": true
        },
        "blurMedia": {
          "title": "Blur media until hovered",
          "type": "boolean",
          "default": false
        },
        "blurAvatars": {
          "title": "Blur profile pictures until hovered",
          "type": "boolean",
          "default": false
        },
        "blurEmotes": {
          "title": "Blur emotes until hovered",
          "type": "boolean",
          "default": false
        },
        "loadingAnimal": {
          "type": "string",
          "default": ""
        },
        "mediaAutoLoad": {
          "title": "Load media automatically",
          "enum": [
            "on",
            "private",
            "off"
          ],
          "default": "on"
        },
        "autoplayGifs": {
          "title": "Autoplay animated images",
          "type": "boolean",
          "default": true
        },
        "pauseAnimationsWhenInactive": {
          "title": "Pause animations when the window is inactive",
          "type": "boolean",
          "default": false
        },
        "autoplayStickers": {
          "title": "Autoplay stickers and emoji",
          "type": "boolean",
          "default": true
        },
        "urlPreviews": {
          "title": "Server-side embeds",
          "type": "boolean",
          "default": false
        },
        "themeFileCards": {
          "title": "Show install cards for theme files",
          "type": "boolean",
          "default": true
        },
        "badgeDefaultDirect": {
          "enum": [
            "all",
            "mentions",
            "quiet"
          ],
          "default": "all"
        },
        "badgeDefaultGroup": {
          "enum": [
            "all",
            "mentions",
            "quiet"
          ],
          "default": "mentions"
        },
        "notifyOnce": {
          "title": "One alert per room",
          "type": "boolean",
          "default": true
        },
        "highlightMentions": {
          "title": "Highlight mentions",
          "type": "boolean",
          "default": true
        },
        "faviconForMentionsOnly": {
          "title": "Tab badge for mentions and keywords",
          "type": "boolean",
          "default": false
        },
        "ringForGroupCalls": {
          "title": "Show call screen for groups and voice channels",
          "type": "boolean",
          "default": false
        },
        "alwaysShowCallButton": {
          "title": "Show call button in rooms with more than 10 members",
          "type": "boolean",
          "default": false
        },
        "callScreenPreview": {
          "title": "Show a shared screen outside the call",
          "type": "boolean",
          "default": true
        },
        "incomingCallSound": {
          "title": "In-app incoming call sound",
          "type": "boolean",
          "default": true
        },
        "outgoingRingback": {
          "title": "Play a ringing tone while calling",
          "type": "boolean",
          "default": true
        },
        "profileChangePropagation": {
          "title": "Apply name and avatar changes to",
          "enum": [
            "all",
            "unchanged",
            "none"
          ],
          "default": "unchanged"
        }
      }
    },
    "settingsLocked": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "title": "Language",
          "enum": [
            "system",
            "ar",
            "bg",
            "cs",
            "de",
            "en",
            "es",
            "fi",
            "fr",
            "hu",
            "it",
            "mi",
            "nl",
            "pl",
            "pt",
            "pt-BR",
            "ro",
            "ru",
            "th",
            "tok",
            "tr",
            "uk",
            "zh-Hans"
          ],
          "default": "system"
        },
        "layout": {
          "title": "Layout",
          "enum": [
            "modern",
            "compact",
            "bubble"
          ],
          "default": "modern"
        },
        "threadPresentation": {
          "title": "Threads and discussions",
          "enum": [
            "timeline",
            "panel"
          ],
          "default": "timeline"
        },
        "alignOwnMessages": {
          "title": "Right-align own messages",
          "type": "boolean",
          "default": true
        },
        "avatarsInMessageHeaders": {
          "title": "Display avatars in message headers",
          "type": "boolean",
          "default": true
        },
        "messageSpacing": {
          "title": "Message spacing",
          "enum": [
            "none",
            "compact",
            "cozy",
            "roomy"
          ],
          "default": "cozy"
        },
        "timelineEmoteSize": {
          "title": "Emote size",
          "enum": [
            "default",
            "20",
            "24",
            "32",
            "48",
            "64"
          ],
          "default": "default"
        },
        "theme": {
          "title": "Light or dark",
          "enum": [
            "system",
            "dark",
            "light"
          ],
          "default": "system"
        },
        "fontFamily": {
          "type": "string",
          "default": ""
        },
        "fontFamilyMono": {
          "type": "string",
          "default": ""
        },
        "codeLigatures": {
          "type": "boolean",
          "default": true
        },
        "underlineLinks": {
          "title": "Always underline links",
          "type": "boolean",
          "default": true
        },
        "renderRoomColors": {
          "title": "Use room colours instead of profile colours",
          "type": "boolean",
          "default": true
        },
        "renderProfileColors": {
          "title": "Show profile name colours",
          "type": "boolean",
          "default": true
        },
        "reducedMotion": {
          "title": "Reduce motion",
          "type": "boolean"
        },
        "pageZoom": {
          "title": "Interface scale",
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.5,
          "default": 1
        },
        "textScale": {
          "title": "Text size",
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.5,
          "default": 1
