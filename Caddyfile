{
	servers {
		protocols h1 h2c
	}
}

:8080 {
	root * /app

	encode zstd gzip

	try_files {path} {path}.html {path}/index.html /index.html

	file_server

	# Content-hashed assets can be cached indefinitely — the filename changes on every build.
	header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# Mounted over by a deployment, so an edit must not wait out a cache.
	header /config.json Cache-Control "no-cache"
}
