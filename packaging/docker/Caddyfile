{
	admin off

	servers {
		protocols h1 h2c
	}
}

:8080 {
	root * /app

	encode zstd gzip
	import /app/csp.caddy

	# A hashed asset from a replaced build must 404, not come back as index.html.
	handle /_app/* {
		file_server
	}

	handle {
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}

	# Content-hashed assets can be cached indefinitely — the filename changes on every build.
	@immutable {
		path /_app/immutable/*
		file
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"

	header /manifest.webmanifest Content-Type "application/manifest+json"
}
