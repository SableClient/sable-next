<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>moe.sable.next.electron</id>

  <name>Sable</name>
  <summary>Chat over the Matrix network</summary>

  <developer id="moe.sable">
    <name>Sable Maintainers</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <url type="homepage">https://sable.moe</url>
  <url type="bugtracker">https://git.sable.moe/SableClient/sable-next/issues</url>
  <url type="vcs-browser">https://git.sable.moe/SableClient/sable-next</url>

  <branding>
    <color type="primary" scheme_preference="light">#b9abfa</color>
    <color type="primary" scheme_preference="dark">#4b3f8f</color>
  </branding>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
  </content_rating>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <description>
    <p>
      Sable is a Matrix client for desktop, with end-to-end encrypted
      messaging, spaces, threads, and voice and video calls.
    </p>
    <p>Features:</p>
    <ul>
      <li>End-to-end encryption with cross-signing and key backup</li>
      <li>Spaces, threads, and replies</li>
      <li>Voice and video calls</li>
      <li>Custom themes</li>
    </ul>
  </description>

  <launchable type="desktop-id">moe.sable.next.electron.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/SableClient/Sable/dev/docs/screenshots/timeline.png</image>
      <caption>Catching up on a room timeline</caption>
    </screenshot>
  </screenshots>

