{
  // SvelteKit excludes the service worker from the app's tsconfig, since it
  // compiles against webworker libs rather than the DOM's. Without this it would
  // be the one file nothing type-checks.
  "extends": "./.svelte-kit/tsconfig.json",
  "include": [
    "src/app.d.ts",
    "src/service-worker.ts",
    "src/lib/features/notifications/push-payload.ts",
    "src/lib/features/notifications/room-names.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "lib": ["esnext", "webworker"],
    "types": ["@sveltejs/kit"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "bundler"
  }
}
