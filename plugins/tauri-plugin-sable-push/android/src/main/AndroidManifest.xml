<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Incoming calls ring full screen over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application>
        <meta-data
            android:name="app.tauri.notification.PUSH_DELEGATE"
            android:value="moe.sable.push.SablePushDelegate" />
        <receiver
            android:name="moe.sable.push.ConversationActionReceiver"
            android:exported="false" />
    </application>
</manifest>
