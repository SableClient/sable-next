{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sable",
  "version": "2.3.0",
  "identifier": "moe.sable.next",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Sable",
        "create": false,
        "backgroundColor": "#24232c"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net/npm/@arborium/",
        "style-src": "'self' 'unsafe-inline' https:",
        "font-src": "'self' data: https:",
        "img-src": "'self' data: blob: https: sable-tiles: http://sable-tiles.localhost",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http: wss: ws: blob: data:",
        "worker-src": "'self' blob:",
        "frame-src": "https: http:",
        "frame-ancestors": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "SableClient",
    "copyright": "Copyright © SableClient contributors",
    "shortDescription": "A Matrix client",
    "longDescription": "Sable, a Matrix client.",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "SocialNetworking",
    "homepage": "https://sable.moe",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "android": {
      "versionCode": 20010040,
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "template": "src-tauri/ios-project.yml",
      "minimumSystemVersion": "15.4",
      "frameworks": [
        "AudioToolbox",
        "Photos",
        "Frameworks/LiveKitWebRTC.xcframework",
        "Frameworks/RustLiveKitUniFFI.xcframework"
      ]
    }
  },
  "plugins": {
    "notifications": {
      "actionTypes": [
        {
          "id": "sable-message",
          "actions": [
            {
              "id": "sable-reply",
              "title": "Reply",
              "input": true,
              "inputButtonTitle": "Send",
              "inputPlaceholder": "Message"
            },
            {
              "id": "sable-mark-read",
              "title": "Mark as read",
              "foreground": false
            }
          ]
        },
        {
          "id": "sable-invite",
          "actions": [
            {
              "id": "sable-invite-accept",
              "title": "Accept",
              "foreground": true
            },
            {
              "id": "sable-invite-decline",
              "title": "Decline",
              "foreground": false
            }
          ]
        }
      ]
    },
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "moe.sable.next",
            "matrix"
          ],
          "appLink": false
        },
        {
          "scheme": [
            "https"
          ],
          "host": "matrix.to",
          "appLink": false
        }
      ]
    }
  }
}