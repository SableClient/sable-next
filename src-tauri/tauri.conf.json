{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sable Next",
  "version": "0.1.0",
  "identifier": "moe.sable.next",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Sable",
        "create": false,
        "hiddenTitle": true,
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "backgroundColor": "#24232c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "SableClient",
    "copyright": "Copyright © SableClient contributors",
    "shortDescription": "A Matrix client",
    "longDescription": "Sable Next, a Matrix client.",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "SocialNetworking",
    "homepage": "https://sable.moe",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Sable"
      },
      "wix": {
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    },
    "macOS": {
      "dmg": {
        "background": "icons/installer/dmg-background.png"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "template": "src-tauri/ios-project.yml",
      "minimumSystemVersion": "16.0",
      "frameworks": [
        "AudioToolbox",
        "Photos",
        "Frameworks/LiveKitWebRTC.xcframework",
        "Frameworks/RustLiveKitUniFFI.xcframework"
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://git.sable.moe/SableClient/sable-next/releases/download/latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxNEQxMkJEQzU0QTI0MDcKUldRSEpFckZ2UkpOSWVhMW01SFRIb0JFZDhldVZNLzV6R29nb0I5TWdKcTRQOXRXN3JwdXQ0OEkK"
    },
    "notifications": {
      "actionTypes": [
        {
          "id": "sable-message",
          "actions": [
            {
              "id": "sable-reply",
              "title": "Reply",
              "input": true,
              "inputButtonTitle": "Send",
              "inputPlaceholder": "Message"
            },
            { "id": "sable-mark-read", "title": "Mark as read" }
          ]
        }
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["moe.sable.next", "sable"]
      },
      "mobile": [
        {
          "scheme": ["moe.sable.next", "sable"],
          "appLink": false
        }
      ]
    }
  }
}
