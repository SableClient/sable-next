{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-capability",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "window-state:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-set-badge-count"
  ]
}
