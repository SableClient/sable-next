{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "share-capability",
  "description": "hands a media file to the system share sheet",
  "platforms": ["android", "iOS", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "sharekit:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPCACHE/outgoing-share" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPCACHE/outgoing-share/*" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPCACHE/outgoing-share/*" }]
    }
  ]
}
